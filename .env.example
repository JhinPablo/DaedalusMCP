# Production: non-secret identity configuration. The Worker fails closed until set.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-audience
OWNER_EMAIL=you@example.com
# Connector only. Never put this value in a VITE_ variable or commit it.
DAEDALUS_CONNECTOR_TOKEN=
# Machine access through the Cloudflare Access Service Auth policy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Optional local OpenCode HTTP basic authentication.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
