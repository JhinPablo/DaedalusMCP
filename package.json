{
  "name": "daedalus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "preview": "tsx scripts/dev.ts --production",
    "build": "npm run typecheck && vite build && esbuild src/worker/index.ts --bundle --format=esm --platform=browser --external:cloudflare:* --outfile=dist/worker/index.js && tsx scripts/package-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "connector": "tsx src/connector/index.ts",
    "opencode:serve": "tsx scripts/opencode.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test:engines": "tsx scripts/smoke-engines.ts",
    "test:live": "tsx scripts/smoke-flow.ts",
    "skills:sync": "tsx scripts/sync-skills.ts",
    "cf": "cf",
    "deploy:preview": "cf deploy --prebuilt --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/hashes": "^2.0.0",
    "@opencode-ai/sdk": "latest",
    "@xyflow/react": "^12.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "^0.9.10",
    "@cloudflare/config": "^0.30.2",
    "@cloudflare/workers-types": "latest",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cf": "1.0.0-beta.28",
    "esbuild": "^0.25.0",
    "miniflare": "latest",
    "opencode-ai": "^1.19.5",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
